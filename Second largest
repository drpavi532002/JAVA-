
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int largest=Integer.MIN_VALUE;
        int Secondl=Integer.MIN_VALUE;
        for(int i=0;i<n;i++){
            if(arr[i]>largest){
                Secondl=largest;
                largest=arr[i];
            }
            else if(arr[i]>Secondl && arr[i]!=largest){
                Secondl=arr[i];
            }
        }
            System.out.println("Second largest: " + Secondl);
    }
}
