
import java.util.*;

public class Main {

    static long atMostK(String s, int k) {
        if (k <= 0) return 0;

        int[] freq = new int[26];
        int left = 0, distinct = 0;
        long count = 0;

        for (int right = 0; right < s.length(); right++) {
            int c = s.charAt(right) - 'a';

            if (freq[c] == 0) distinct++;
            freq[c]++;

            while (distinct > k) {
                int ch = s.charAt(left) - 'a';
                freq[ch]--;

                if (freq[ch] == 0) distinct--;
                left++;
            }

            count += right - left + 1;
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s = sc.nextLine();
        int k = sc.nextInt();

        long ans = atMostK(s, k) - atMostK(s, k - 1);

        System.out.println("Substring Count: " + ans);
    }
}
