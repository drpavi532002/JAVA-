import java.util.*;
public class Main {

	public static void main(String args[]) {
		Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
		int n1=sc.nextInt();
		int key=4;
		boolean b=false;
		int arr[][]=new int[n][n1];
		for(int i=0;i<n;i++) {/			for(int j=0;j<n1;j++) {
				arr[i][j]=sc.nextInt();
			}
			
		}
		System.out.println("Matrix:");
		for(int i=0;i<n;i++) {
			for(int j=0;j<n;j++) {
				System.out.print(arr[i][j] + " ");
				
			}
			System.out.println();
		}
		for(int i=0;i<n;i++) {
			for(int j=0;j<n1;j++) {
				if(arr[i][j]==key) {
					b=true;
					break;
				}
			}
			if(b) {
				break;
			}
		}
		if(b) {
			System.out.println("key found");
		}
		else {
			System.out.println("key not found");
		}
}
}
		
		
